#version 450
#extension GL_ARB_gpu_shader_int64 : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Edges { ivec4 edges[]; };
struct Query { ivec4 p; uvec4 meta; };
layout(std430, binding = 1) readonly buffer Queries { Query queries[]; };
layout(std430, binding = 2) writeonly buffer Results { uint results[]; };
layout(push_constant) uniform Parameters { uint count; uint edge_count; float unused0; float unused1; } params;

bool eligible(ivec4 p) {
    return all(greaterThanEqual(p, ivec4(-536870912))) && all(lessThanEqual(p, ivec4(536870912)));
}
int64_t orient(ivec2 a, ivec2 b, ivec2 p) {
    return (int64_t(b.x) - a.x) * (int64_t(p.y) - a.y) - (int64_t(b.y) - a.y) * (int64_t(p.x) - a.x);
}
bool same_side(int64_t a, int64_t b) { return (a > 0 && b > 0) || (a < 0 && b < 0); }
uint classify(Query q) {
    ivec4 p = q.p;
    if (!eligible(p) || q.meta.x > params.edge_count || q.meta.y > params.edge_count - q.meta.x ||
        all(equal(p.xy, p.zw)))
        return 0;
    int winding = 0;
    for (uint i = q.meta.x; i < q.meta.x + q.meta.y; ++i) {
        ivec4 e = edges[i];
        if (!eligible(e))
            return 0;
        int64_t a = orient(e.xy, e.zw, p.xy);
        int64_t b = orient(e.xy, e.zw, p.zw);
        if (all(greaterThanEqual(max(p.xy, p.zw) + 2, min(e.xy, e.zw))) &&
            all(lessThanEqual(min(p.xy, p.zw) - 2, max(e.xy, e.zw)))) {
            int64_t c = orient(p.xy, p.zw, e.xy);
            int64_t d = orient(p.xy, p.zw, e.zw);
            int64_t margin = 2 * (abs(int64_t(e.z) - e.x) + abs(int64_t(e.w) - e.y));
            int64_t subject_margin = 2 * (abs(int64_t(p.z) - p.x) + abs(int64_t(p.w) - p.y));
            if ((!same_side(a, b) && !same_side(c, d)) || abs(a) <= margin || abs(b) <= margin ||
                abs(c) <= subject_margin || abs(d) <= subject_margin)
                return 0;
        }
        if (e.y <= p.y && e.w > p.y && a > 0)
            ++winding;
        else if (e.y > p.y && e.w <= p.y && a < 0)
            --winding;
    }
    bool empty = q.meta.z != 0 ? winding != 0 : winding == 0;
    // Existing callers keep the binary protocol; keep-whole is diagnostic only.
    return empty ? 1u : (q.meta.w != 0 ? 2u : 0u);
}
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < params.count)
        results[i] = classify(queries[i]);
}
