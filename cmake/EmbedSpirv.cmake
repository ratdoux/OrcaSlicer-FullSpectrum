# Produce an embedded, aligned uint32_t array from the compiled shader.
file(READ "${INPUT}" _hex HEX)
string(LENGTH "${_hex}" _length)
math(EXPR _last "${_length} - 8")
if(NOT SYMBOL)
    set(SYMBOL SEAM_VISIBILITY_SPIRV)
endif()
set(_text "// Generated SPIR-V; do not edit.\nstatic constexpr uint32_t ${SYMBOL}[] = {\n")
foreach(_offset RANGE 0 ${_last} 8)
    string(SUBSTRING "${_hex}" ${_offset} 8 _word)
    string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1," _word "${_word}")
    string(APPEND _text "${_word}\n")
endforeach()
string(APPEND _text "};\n")
file(WRITE "${OUTPUT}" "${_text}")
